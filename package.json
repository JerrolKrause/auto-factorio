{
  "name": "autofactorio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint scripts packages tests",
    "test": "vitest run",
