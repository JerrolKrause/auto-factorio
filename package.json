{
  "name": "autofactorio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -b --stopBuildOnErrors && vite build apps/dashboard",
    "dashboard": "node dist/scripts/dashboard.js",
    "test:ui": "playwright test",
    "game:dashboard-probe": "node dist/scripts/game-dashboard-probe.js",
    "game:verification-probe": "node dist/scripts/game-verification-probe.js",
    "scenario:launch": "node dist/scripts/scenario.js",
    "scenario:trial": "node dist/scripts/scenario-trial.js",
    "game:first-shift-probe": "node dist/scripts/game-first-shift-probe.js",
    "game:plate-to-science-probe": "node dist/scripts/game-plate-to-science-probe.js",
    "lint": "eslint scripts packages apps tests",
    "test": "vitest run",
    "diagnose": "node dist/scripts/diagnose.js",
    "check:docs": "node scripts/check-docs.mjs",
    "provider:probe": "node dist/scripts/provider-probe.js",
    "game:launch": "node dist/scripts/game-launch.js",
    "game:smoke": "node dist/scripts/game-smoke.js",
    "game:probe": "node dist/scripts/game-probe.js",
    "game:load-probe": "node dist/scripts/game-load-probe.js",
    "game:pause-probe": "node dist/scripts/game-pause-probe.js",
    "verify": "node scripts/verify.mjs",
    "game:processes": "node dist/scripts/game-processes.js",
    "game:durable-probe": "node dist/scripts/game-durable-probe.js",
    "game:ownership-probe": "node dist/scripts/game-ownership-probe.js",
    "game:coordination-probe": "node dist/scripts/game-coordination-probe.js",
    "dev:usage": "node scripts/dev/usage.mjs",
    "dev:watch": "node scripts/dev/watch.mjs",
    "dev:contract": "node scripts/dev/contract.mjs",
    "dev:preflight": "node scripts/dev/preflight.mjs",
    "dev:task": "node scripts/dev/task.mjs"
  },
  "dependencies": {
    "@autofactorio/contracts": "workspace:*",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "4.0.18"
  }
}
