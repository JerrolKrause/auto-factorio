    "provider:probe": "node dist/scripts/provider-probe.js"
  },
  "dependencies": {
    "@autofactorio/contracts": "workspace:*",
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.4",
    "eslint": "9.39.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.0.18"
  }
